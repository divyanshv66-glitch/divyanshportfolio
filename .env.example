# Public URL used for metadata, sitemap and social previews
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# SMTP settings for the contact form (e.g. Gmail app password, Zoho, Resend SMTP, Brevo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-app-password

# Where enquiries are delivered (defaults to contact.email in src/config/site.ts)
CONTACT_TO=you@example.com
# Sender address (defaults to SMTP_USER)
CONTACT_FROM="Portfolio <you@example.com>"
